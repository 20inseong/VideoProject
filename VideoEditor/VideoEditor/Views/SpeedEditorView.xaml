<UserControl x:Class="VideoEditor.Views.SpeedEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VideoEditor.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="300">
    <StackPanel Margin="10">
        <TextBlock Text="배속 설정" FontWeight="Bold" Foreground="White" FontSize="16" Margin="0,0,0,10" />
        <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
            <TextBlock Text="배속:" Foreground="White" VerticalAlignment="Center" Width="80" />
            <TextBox Width="70" Text="{Binding PlaybackRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"/>
            <!-- 적용 버튼은 TextBox의 UpdateSourceTrigger로 인해 불필요해졌습니다. -->
        </StackPanel>
        <TextBlock Text="프리셋:" Foreground="White" Margin="0,10,0,5" />
        <UniformGrid Columns="3" Rows="3">
            <Button Content="0.5x" Margin="2" Command="{Binding SetSpeed05Command}"/>
            <Button Content="0.75x" Margin="2" Command="{Binding SetSpeed075Command}"/>
            <Button Content="1.0x" Margin="2" Command="{Binding SetSpeed1Command}"/>
            <Button Content="1.25x" Margin="2" Command="{Binding SetSpeed125Command}"/>
            <Button Content="1.5x" Margin="2" Command="{Binding SetSpeed15Command}"/>
            <Button Content="2.0x" Margin="2" Command="{Binding SetSpeed2Command}"/>
        </UniformGrid>
        <TextBlock Text="슬라이더:" Foreground="White" Margin="0,10,0,5" />
        <Slider Minimum="0.25" Maximum="2.0" Value="{Binding PlaybackRate, Mode=TwoWay}" 
                TickFrequency="0.25" IsSnapToTickEnabled="True" />
        <TextBlock Text="{Binding PlaybackRateText}" Foreground="White" HorizontalAlignment="Center" Margin="0,5,0,0" />
    </StackPanel>
</UserControl>
