<UserControl x:Class="VideoEditor.Views.ClipEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VideoEditor.Views"
             xmlns:models="clr-namespace:VideoEditor.Models"
             xmlns:common="clr-namespace:VideoEditor.Common"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="300">

    <UserControl.Resources>
        <common:ClipTypeToStringConverter x:Key="ClipTypeToStringConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <common:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </UserControl.Resources>

    <ContentControl Content="{Binding}">
        <ContentControl.Resources>
            <!-- 1. TextClip 편집기 -->
            <DataTemplate DataType="{x:Type models:TextClip}">
                <StackPanel Margin="15">
                    <TextBlock Text="자막 편집" FontWeight="Bold" Foreground="White" FontSize="16" Margin="0,0,0,15"/>
                    <TextBlock Text="이름:" Foreground="White" Margin="0,10,0,5" FontWeight="Bold"/>
                    <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                    <TextBlock Text="내용:" Foreground="White" Margin="0,0,0,5" FontWeight="Bold"/>
                    <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto"/>
                    <local:TransformEditorView />
                </StackPanel>
            </DataTemplate>

            <!-- 2. VideoClip 편집기 -->
            <DataTemplate DataType="{x:Type models:VideoClip}">
                <StackPanel Margin="15">
                    <!-- 상단 제목 -->
                    <TextBlock Text="비디오 클립 편집" FontWeight="Bold" Foreground="White" FontSize="16" Margin="0,0,0,15"/>

                    <!-- 기본 정보 -->
                    <TextBlock Text="이름:" Foreground="White" Margin="0,10,0,5" FontWeight="Bold"/>
                    <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                    <TextBlock Text="길이 (초):" Foreground="White" Margin="0,0,0,5" FontWeight="Bold"/>
                    <TextBox Text="{Binding Duration, Mode=TwoWay, StringFormat={}{0:F2}, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="볼륨:" Foreground="White" Margin="0,10,0,5" FontWeight="Bold"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="videoVolumeSlider" Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding ElementName=videoVolumeSlider, Path=Value, StringFormat={}{0:F0}}" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Transcription Section -->
                    <TextBlock Text="음성 텍스트 변환" FontWeight="Bold" Foreground="White" FontSize="16" Margin="0,20,0,15"/>

                    <local:TransformEditorView />

                    <!-- 버튼 3개 (스크립트 생성 / 확인 / 숨기기) -->
                    <StackPanel Orientation="Horizontal">
                        <Button Content="스크립트 생성"
                    Command="{Binding DataContext.TranscribeVideoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    IsEnabled="{Binding IsTranscribing, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"
                    Margin="0,0,5,0" Width="100">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTranscribed}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="스크립트 확인"
                    Command="{Binding ShowTranscriptionCommand}"
                    Margin="0,0,5,0" Width="100">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTranscribed}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ShowTranscription}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="숨기기"
                    Command="{Binding HideTranscriptionCommand}"
                    Margin="0,0,5,0" Width="100">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowTranscription}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- 변환 진행률 표시 -->
                    <ProgressBar Value="{Binding DataContext.TranscriptionProgress, RelativeSource={RelativeSource AncestorType=Window}}"
                     Visibility="{Binding IsTranscribing, Converter={StaticResource BooleanToVisibilityConverter}}"
                     Height="10" Margin="0,10,0,0"/>

                    <!-- 텍스트 변환 결과 -->
                    <ListView ItemsSource="{Binding Transcription}"
                  Visibility="{Binding ShowTranscription, Converter={StaticResource BooleanToVisibilityConverter}}"
                  HorizontalContentAlignment="Stretch" Background="#36443d" Foreground="White" BorderThickness="0"
                  Height="200" Margin="0,10,0,0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2,0,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Start, StringFormat='{}{0:hh\\:mm\\:ss\\.fff}'}" Margin="5,0" FontWeight="Bold"/>
                                        <TextBlock Text=" - " Margin="0,0" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding End, StringFormat='{}{0:hh\\:mm\\:ss\\.fff}'}" Margin="0,0" FontWeight="Bold"/>
                                        <TextBlock Text=" (" Margin="5,0,0,0" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Duration.TotalSeconds, StringFormat='{}{0:F2}s'}" Margin="0,0" FontWeight="Bold"/>
                                        <TextBlock Text=")" Margin="0,0,5,0" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBox Text="{Binding Text}"
                                 TextWrapping="Wrap"
                                 Margin="16,2,5,0"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListView}, Path=Foreground}"
                                 AcceptsReturn="True"
                                 HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </DataTemplate>


            <!-- 3. ImageClip 편집기 -->
            <DataTemplate DataType="{x:Type models:ImageClip}">
                <StackPanel Margin="15">
                    <TextBlock Text="이미지 클립 편집" FontWeight="Bold" Foreground="White" FontSize="16" Margin="0,0,0,15"/>
                    <TextBlock Text="이름:" Foreground="White" Margin="0,10,0,5" FontWeight="Bold"/>
                    <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                    <TextBlock Text="길이 (초):" Foreground="White" Margin="0,0,0,5" FontWeight="Bold"/>
                    <TextBox Text="{Binding Duration, Mode=TwoWay, StringFormat={}{0:F2}, UpdateSourceTrigger=PropertyChanged}"/>
                    <local:TransformEditorView />
                </StackPanel>
            </DataTemplate>

            <!-- 4. AudioClip 편집기 -->
            <DataTemplate DataType="{x:Type models:AudioClip}">
                <StackPanel Margin="15">
                    <TextBlock Text="오디오 클립 편집" FontWeight="Bold" Foreground="White" FontSize="16" Margin="0,0,0,15"/>
                    <TextBlock Text="이름:" Foreground="White" Margin="0,10,0,5" FontWeight="Bold"/>
                    <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                    <TextBlock Text="길이 (초):" Foreground="White" Margin="0,0,0,5" FontWeight="Bold"/>
                    <TextBox Text="{Binding Duration, Mode=TwoWay, StringFormat={}{0:F2}, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="볼륨:" Foreground="White" Margin="0,10,0,5" FontWeight="Bold"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="audioVolumeSlider" Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding ElementName=audioVolumeSlider, Path=Value, StringFormat={}{0:F0}}" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Transcription Section -->
                    <TextBlock Text="음성 텍스트 변환" FontWeight="Bold" Foreground="White" FontSize="16" Margin="0,20,0,15"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="스크립트 생성"
                                Command="{Binding DataContext.TranscribeVideoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                IsEnabled="{Binding IsTranscribing, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"
                                Margin="0,0,5,0" Width="100">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTranscribed}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="스크립트 확인"
                                Command="{Binding ShowTranscriptionCommand}"
                                Margin="0,0,5,0" Width="100">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTranscribed}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ShowTranscription}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="숨기기"
                                Command="{Binding HideTranscriptionCommand}"
                                Margin="0,0,5,0" Width="100">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowTranscription}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <ProgressBar Value="{Binding DataContext.TranscriptionProgress, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Visibility="{Binding IsTranscribing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Height="10" Margin="0,10,0,0"/>

                    <ListView ItemsSource="{Binding Transcription}"
                              Visibility="{Binding ShowTranscription, Converter={StaticResource BooleanToVisibilityConverter}}"
                              HorizontalContentAlignment="Stretch" Background="#36443d" Foreground="White" BorderThickness="0"
                              Height="200" Margin="0,10,0,0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2,0,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Start, StringFormat='{}{0:hh\\:mm\\:ss\\.fff}'}" Margin="5,0" FontWeight="Bold"/>
                                        <TextBlock Text=" - " Margin="0,0" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding End, StringFormat='{}{0:hh\\:mm\\:ss\\.fff}'}" Margin="0,0" FontWeight="Bold"/>
                                        <TextBlock Text=" (" Margin="5,0,0,0" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Duration.TotalSeconds, StringFormat='{}{0:F2}s'}" Margin="0,0" FontWeight="Bold"/>
                                        <TextBlock Text=")" Margin="0,0,5,0" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBox Text="{Binding Text}"
                                             TextWrapping="Wrap"
                                             Margin="16,2,5,0"
                                             IsReadOnly="True"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListView}, Path=Foreground}"
                                             AcceptsReturn="True"
                                             HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </DataTemplate>
        </ContentControl.Resources>
    </ContentControl>
</UserControl>
