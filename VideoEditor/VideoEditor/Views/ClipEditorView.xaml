<UserControl x:Class="VideoEditor.Views.ClipEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VideoEditor.Views"
             xmlns:models="clr-namespace:VideoEditor.Models"
             xmlns:common="clr-namespace:VideoEditor.Common"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="300">

    <UserControl.Resources>
        <common:ClipTypeToStringConverter x:Key="ClipTypeToStringConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <common:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <common:IsAudioClipInGroupConverter x:Key="IsAudioClipInGroupConverter" />
        <common:AbsoluteTimestampConverter x:Key="AbsoluteTimestampConverter" />

        <Style x:Key="MutedStateTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="Foreground" Value="Gray" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MuteCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="IsEnabled" Value="True"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource IsAudioClipInGroupConverter}">
                            <Binding Path="GroupId"/>
                            <Binding Path="DataContext.VideoEditor.TimelineClips" RelativeSource="{RelativeSource AncestorType=Window}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Foreground" Value="Gray"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WpfUiLikeColorPickerStyle" TargetType="{x:Type xctk:ColorPicker}">
            <Setter Property="Background" Value="#3D3D3D" />
            <Setter Property="BorderBrush" Value="#888888" />
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type xctk:ColorPicker}">
                        <Grid x:Name="templateRoot">

                            <!-- 1. 컨트롤의 핵심인 ToggleButton (원본 구조 유지) -->
                            <ToggleButton x:Name="PART_ColorPickerToggleButton"
                                      IsChecked="{Binding IsOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Style="{x:Null}">
                                <!-- 기본 토글버튼 스타일 제거 -->
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="MainBorder"
                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=xctk:ColorPicker}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=xctk:ColorPicker}}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="3">
                                            <Grid Margin="5,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="18" Height="18"
                                                    BorderBrush="#AAAAAA" BorderThickness="1" CornerRadius="2"
                                                    Background="{Binding SelectedColor, RelativeSource={RelativeSource AncestorType=xctk:ColorPicker}, Converter={StaticResource ColorToBrushConverter}}"/>

                                                <TextBlock Grid.Column="1"
                                                       Text="{Binding SelectedColorText, RelativeSource={RelativeSource AncestorType=xctk:ColorPicker}}"
                                                       Foreground="White"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0" />

                                                <Path Grid.Column="2" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#DDDDDD"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- 2. 컨트롤의 핵심인 Popup (원본 구조 유지) -->
                            <Popup x:Name="PART_Popup"
                               IsOpen="{Binding IsOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                               AllowsTransparency="True"
                               StaysOpen="False"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=PART_ColorPickerToggleButton}">
                                <!-- 팝업 내부 UI 스타일링 -->
                                <Border Background="#2B2B2B" BorderBrush="#888888" BorderThickness="1" Padding="5" CornerRadius="3">
                                    <xctk:ColorCanvas x:Name="PART_ColorCanvas"
                                                  SelectedColor="{Binding SelectedColor, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- 3. 상태 변화에 따른 시각적 효과 (Triggers) -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="White" />
                            </Trigger>
                            <Trigger Property="IsOpen" Value="True">
                                <Setter Property="BorderBrush" Value="#007ACC" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ContentControl Content="{Binding}">
        <ContentControl.Resources>
            <!-- 1. TextClip 편집기 -->
            <DataTemplate DataType="{x:Type models:TextClip}">
                <StackPanel Margin="15">
                    <TextBlock Text="자막 편집" FontWeight="Bold" Foreground="White" FontSize="16" Margin="0,0,0,15"/>
                    <TextBlock Text="이름:" Foreground="White" Margin="0,10,0,5" FontWeight="Bold"/>
                    <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                    <TextBlock Text="내용:" Foreground="White" Margin="0,0,0,5" FontWeight="Bold"/>
                    <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>
                    <TextBlock Text="글자 크기:" Foreground="White" Margin="0,0,0,5" FontWeight="Bold"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Minimum="12" Maximum="72" Value="{Binding FontSize, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding FontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F0}}" Margin="10,0,0,0" VerticalAlignment="Center" Width="50"/>
                    </Grid>

                    <TextBlock Text="글꼴:" Foreground="White" Margin="0,10,0,5" FontWeight="Bold"/>
                    <ComboBox ItemsSource="{Binding Source={x:Static Fonts.SystemFontFamilies}}"
                              SelectedItem="{Binding FontFamily, Converter={StaticResource FontFamilyConverter}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="{Binding}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="색상 (Hex):" Foreground="White" Margin="0,10,0,5" FontWeight="Bold"/>
                    <xctk:ColorPicker SelectedColor="{Binding ForegroundColor, Mode=TwoWay}"
                                      DisplayColorAndName="True"
                                      Style="{StaticResource WpfUiLikeColorPickerStyle}"/>

                    <TextBlock Text="투명도:" Foreground="White" Margin="0,10,0,5" FontWeight="Bold"/>
                    <Slider Minimum="0.0" Maximum="1.0" Value="{Binding Opacity, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True" />

                    <TextBlock Text="회전 (각도):" Foreground="White" Margin="0,10,0,5" FontWeight="Bold"/>
                    <Slider Minimum="0" Maximum="360" Value="{Binding Rotation, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" />
                </StackPanel>
            </DataTemplate>

            <!-- 2. VideoClip 편집기 -->
            <DataTemplate DataType="{x:Type models:VideoClip}">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 상단 제목 -->
                    <TextBlock Grid.Row="0" Text="비디오 클립 편집" FontWeight="Bold" Foreground="White" FontSize="16" Margin="0,0,0,15"/>

                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="이름:" Foreground="White" Margin="0,0,0,5" FontWeight="Bold"/>
                        <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                        <TextBlock Text="길이 (초):" Foreground="White" Margin="0,0,0,5" FontWeight="Bold"/>
                        <TextBox Text="{Binding Duration, StringFormat={}{0:F2}}" IsReadOnly="True"/>
                    </StackPanel>

                    <!-- Speed Control -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,10">
                        <TextBlock Text="배속:" Foreground="White" Margin="0,0,0,5" FontWeight="Bold"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="0.1" Maximum="4" Value="{Binding SpeedRatio, Mode=TwoWay}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding SpeedRatio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F1}}" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center" Width="50" GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"/>
                        </Grid>
                    </StackPanel>

                    <!-- Volume Control -->
                    <StackPanel Grid.Row="4" Margin="0,0,0,10">
                        <TextBlock Text="볼륨:" Foreground="White" Margin="0,0,0,5" FontWeight="Bold"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center"
                                    IsEnabled="{Binding IsMuted, Converter={StaticResource InverseBooleanConverter}}"/>
                            <TextBox Grid.Column="1" Text="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F0}}" Margin="10,0,0,0" VerticalAlignment="Center" GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"
                                     Style="{StaticResource MutedStateTextBoxStyle}"/>
                        </Grid>
                    </StackPanel>

                    <CheckBox Grid.Row="5" Content="음소거 (Mute)"
                              IsChecked="{Binding IsMuted, Mode=TwoWay}"
                              Foreground="White"
                              Margin="0,5,0,10"
                              Style="{StaticResource MuteCheckBoxStyle}"/>

                    <!-- Transcription Section -->
                    <TextBlock Grid.Row="6" Text="음성 텍스트 변환" FontWeight="Bold" Foreground="White" FontSize="16" Margin="0,10,0,10"/>

                    <!-- 버튼 4개 (스크립트 생성 / 확인 / 숨기기 / 자막 생성하기) -->
                    <StackPanel Grid.Row="7" Orientation="Horizontal">
                        <Button Content="스크립트 생성"
                                Command="{Binding DataContext.TranscribeVideoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                IsEnabled="{Binding IsTranscribing, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"
                                Margin="0,0,5,0" Width="100">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTranscribed}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="스크립트 확인"
                                Command="{Binding ShowTranscriptionCommand}"
                                Margin="0,0,5,0" Width="100">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTranscribed}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ShowTranscription}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="숨기기"
                                Command="{Binding HideTranscriptionCommand}"
                                Margin="0,0,5,0" Width="100">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowTranscription}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="자막으로 생성"
                                Command="{Binding DataContext.VideoEditor.CreateSubtitlesFromTranscriptionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Margin="5,0,0,0" Width="100">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <!-- 스크립트가 표시될 때만 버튼이 보이도록 설정 -->
                                        <DataTrigger Binding="{Binding ShowTranscription}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- 변환 진행률 표시 -->
                    <ProgressBar Grid.Row="8" Value="{Binding DataContext.TranscriptionProgress, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Visibility="{Binding IsTranscribing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Height="10" Margin="0,10,0,0"/>

                    <!-- 텍스트 변환 결과 -->
                    <ListView Grid.Row="9" ItemsSource="{Binding Transcription}" 
                              Visibility="{Binding ShowTranscription, Converter={StaticResource BooleanToVisibilityConverter}}" 
                              MaxHeight="150" 
                              HorizontalContentAlignment="Stretch" 
                              Background="#36443d" 
                              Foreground="White" 
                              BorderThickness="0" 
                              Margin="0,10,0,0" 
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                                        <TextBlock Text="{Binding Start, StringFormat='{}{0:hh\\:mm\\:ss\\.fff}'}" Margin="5,0" FontWeight="Bold"/>
                                        <TextBlock Text=" - " Margin="0,0" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding End, StringFormat='{}{0:hh\\:mm\\:ss\\.fff}'}" Margin="0,0" FontWeight="Bold"/>
                                        <TextBlock Text=" (" Margin="5,0,0,0" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Duration.TotalSeconds, StringFormat='{}{0:F2}s'}" Margin="0,0" FontWeight="Bold"/>
                                        <TextBlock Text=")" Margin="0,0,5,0" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBox Grid.Row="1" Text="{Binding Text}"
                                             TextWrapping="Wrap"
                                             Margin="16,2,5,0"
                                             IsReadOnly="True"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListView}, Path=Foreground}"
                                             AcceptsReturn="True"
                                             HorizontalAlignment="Stretch" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Grid.Row="10" Text="감정 분석" FontWeight="Bold" Foreground="White" FontSize="16" Margin="0,20,0,10"/>
                    <StackPanel Grid.Row="11" Orientation="Horizontal">
                        <Button Content="감정 분석 실행"
                                Command="{Binding DataContext.AnalyzeEmotionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                IsEnabled="{Binding IsAnalyzingEmotion, Converter={StaticResource InverseBooleanConverter}}"
                                Margin="0,0,5,0" Width="100">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEmotionAnalyzed}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="결과 확인"
                                Command="{Binding ShowEmotionAnalysisCommand}"
                                Margin="0,0,5,0" Width="100">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEmotionAnalyzed}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ShowEmotionAnalysis}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="숨기기"
                                Command="{Binding HideEmotionAnalysisCommand}"
                                Margin="0,0,5,0" Width="100">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowEmotionAnalysis}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <ListView Grid.Row="12" ItemsSource="{Binding EmotionAnalysisResults}" Visibility="{Binding ShowEmotionAnalysis, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalContentAlignment="Stretch" Background="#36443d" Foreground="White" BorderThickness="0" Margin="0,10,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.Resources>
                            <Style x:Key="TimestampButtonStyle" TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.Resources>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- MultiBinding을 사용하는 버튼 -->
                                    <Button Grid.Column="0" 
                                            Style="{StaticResource TimestampButtonStyle}"
                                            Command="{Binding DataContext.SeekToTimestampCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Button.CommandParameter>
                                            <MultiBinding Converter="{StaticResource AbsoluteTimestampConverter}">
                                                <Binding Path="DataContext.StartPosition" RelativeSource="{RelativeSource AncestorType=ListView}" />
                                                <Binding Path="Timestamp" />
                                            </MultiBinding>
                                        </Button.CommandParameter>
                                        <TextBlock FontWeight="Bold" Foreground="SkyBlue">
                                            <Run>
                                                <Run.Text>
                                                    <MultiBinding Converter="{StaticResource AbsoluteTimestampConverter}" StringFormat="{}{0:F2}s">
                                                        <Binding Path="DataContext.StartPosition" RelativeSource="{RelativeSource AncestorType=ListView}" />
                                                        <Binding Path="Timestamp" />
                                                    </MultiBinding>
                                                </Run.Text>
                                            </Run>
                                            <Run Text=":"/>
                                        </TextBlock>
                                    </Button>

                                    <TextBlock Grid.Column="1" Text="{Binding Emotion}" Margin="10,0,0,0" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </DataTemplate>
            
            <!-- 3. ImageClip 편집기 -->
            <DataTemplate DataType="{x:Type models:ImageClip}">
                <StackPanel Margin="15">
                    <TextBlock Text="이미지 클립 편집" FontWeight="Bold" Foreground="White" FontSize="16" Margin="0,0,0,15"/>
                    <TextBlock Text="이름:" Foreground="White" Margin="0,10,0,5" FontWeight="Bold"/>
                    <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                    <TextBlock Text="길이 (초):" Foreground="White" Margin="0,0,0,5" FontWeight="Bold"/>
                    <TextBox Text="{Binding Duration, Mode=TwoWay, StringFormat={}{0:F2}, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="투명도:" Foreground="White" Margin="0,10,0,5" FontWeight="Bold"/>
                    <Slider Minimum="0.0" Maximum="1.0" Value="{Binding Opacity, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True" />

                    <TextBlock Text="회전 (각도):" Foreground="White" Margin="0,10,0,5" FontWeight="Bold"/>
                    <Slider Minimum="0" Maximum="360" Value="{Binding Rotation, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" />

                </StackPanel>
            </DataTemplate>

            <!-- 4. AudioClip 편집기 -->
            <DataTemplate DataType="{x:Type models:AudioClip}">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="오디오 클립 편집" FontWeight="Bold" Foreground="White" FontSize="16" Margin="0,0,0,15"/>
                    
                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="이름:" Foreground="White" Margin="0,0,0,5" FontWeight="Bold"/>
                        <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                        <TextBlock Text="길이 (초):" Foreground="White" Margin="0,0,0,5" FontWeight="Bold"/>
                        <TextBox Text="{Binding Duration, StringFormat={}{0:F2}}" IsReadOnly="True"/>
                    </StackPanel>

                    <!-- Speed Control -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,10">
                        <TextBlock Text="배속:" Foreground="White" Margin="0,0,0,5" FontWeight="Bold"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="0.1" Maximum="4" Value="{Binding SpeedRatio, Mode=TwoWay}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding SpeedRatio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F1}}" Foreground="Black" Margin="10,0,0,0" VerticalAlignment="Center" Width="50" GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"/>
                        </Grid>
                    </StackPanel>

                    <!-- Volume Control -->
                    <StackPanel Grid.Row="4" Margin="0,0,0,10">
                        <TextBlock Text="볼륨:" Foreground="White" Margin="0,0,0,5" FontWeight="Bold"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F0}}" Foreground="Black" Margin="10,0,0,0" VerticalAlignment="Center" GotFocus="TextBox_GotFocus" PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"/>
                        </Grid>
                    </StackPanel>

                    <!-- Transcription Section -->
                    <TextBlock Grid.Row="5" Text="음성 텍스트 변환" FontWeight="Bold" Foreground="White" FontSize="16" Margin="0,10,0,10"/>
                    
                    <StackPanel Grid.Row="6" Orientation="Horizontal">
                        <Button Content="스크립트 생성"
                                Command="{Binding DataContext.TranscribeVideoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                IsEnabled="{Binding IsTranscribing, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"
                                Margin="0,0,5,0" Width="100">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTranscribed}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="스크립트 확인"
                                Command="{Binding ShowTranscriptionCommand}"
                                Margin="0,0,5,0" Width="100">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTranscribed}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ShowTranscription}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="숨기기"
                                Command="{Binding HideTranscriptionCommand}"
                                Margin="0,0,5,0" Width="100">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowTranscription}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="자막으로 생성"
                                Command="{Binding DataContext.VideoEditor.CreateSubtitlesFromTranscriptionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Margin="5,0,0,0" Width="100">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <!-- 스크립트가 표시될 때만 버튼이 보이도록 설정 -->
                                        <DataTrigger Binding="{Binding ShowTranscription}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <ProgressBar Grid.Row="7" Value="{Binding DataContext.TranscriptionProgress, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Visibility="{Binding IsTranscribing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Height="10" Margin="0,10,0,0"/>

                    <ListView Grid.Row="8" ItemsSource="{Binding Transcription}"
                              Visibility="{Binding ShowTranscription, Converter={StaticResource BooleanToVisibilityConverter}}"
                              HorizontalContentAlignment="Stretch" Background="#36443d" Foreground="White" BorderThickness="0"
                              Margin="0,10,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                                        <TextBlock Text="{Binding Start, StringFormat='{}{0:hh\\:mm\\:ss\\.fff}'}" Margin="5,0" FontWeight="Bold"/>
                                        <TextBlock Text=" - " Margin="0,0" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding End, StringFormat='{}{0:hh\\:mm\\:ss\\.fff}'}" Margin="0,0" FontWeight="Bold"/>
                                        <TextBlock Text=" (" Margin="5,0,0,0" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Duration.TotalSeconds, StringFormat='{}{0:F2}s'}" Margin="0,0" FontWeight="Bold"/>
                                        <TextBlock Text=")" Margin="0,0,5,0" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBox Grid.Row="1" Text="{Binding Text}"
                                             TextWrapping="Wrap"
                                             Margin="16,2,5,0"
                                             IsReadOnly="True"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListView}, Path=Foreground}"
                                             AcceptsReturn="True"
                                             HorizontalAlignment="Stretch" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </DataTemplate>
        </ContentControl.Resources>
    </ContentControl>
</UserControl>
