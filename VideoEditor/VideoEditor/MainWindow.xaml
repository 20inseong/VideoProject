<Window x:Class="VideoEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VideoEditor"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:Common="clr-namespace:VideoEditor.Common"
        xmlns:models="clr-namespace:VideoEditor.Models" 
        xmlns:views="clr-namespace:VideoEditor.Views"
        xmlns:controls="clr-namespace:VideoEditor.Views.Controls"
        xmlns:viewmodels="clr-namespace:VideoEditor.ViewModels"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        x:Name="mainWindow"
        Title="MainWindow" Height="800" Width="1500"
        Closing="MainWindow_Closing"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#2B2B2B"
        ResizeMode="CanResizeWithGrip"
        WindowState="Normal">

    <Window.InputBindings>
        <KeyBinding Key="Delete" Command="{Binding VideoEditor.DeleteSelectedClipCommand}" />
        <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding VideoEditor.CopySelectedClipCommand}" />
        <KeyBinding Key="V" Modifiers="Ctrl" Command="{Binding VideoEditor.PasteClipCommand}" CommandParameter="{Binding CurrentTimelinePosition}"/>
    </Window.InputBindings>

    <Window.Resources>
        <Common:TimelineClipTemplateSelector x:Key="ClipTemplateSelector">
            <!-- 1. VideoClip을 위한 템플릿 (기존 템플릿과 동일) -->
            <Common:TimelineClipTemplateSelector.VideoClipTemplate>
                <DataTemplate>
                    <Border Width="{Binding Width}" Height="50" CornerRadius="3" ClipToBounds="True" Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="Black"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BorderBrush" Value="#FFD700"/>
                                        <Setter Property="BorderThickness" Value="2.5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                <b:InvokeCommandAction Command="{Binding DataContext.VideoEditor.ClipMouseDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" PassEventArgsToCommand="True" />
                            </b:EventTrigger>
                            <b:EventTrigger EventName="PreviewMouseMove">
                                <b:InvokeCommandAction Command="{Binding DataContext.VideoEditor.ClipMouseMoveCommand, RelativeSource={RelativeSource AncestorType=Window}}" PassEventArgsToCommand="True" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Top Part: Thumbnails and Name -->
                            <Grid Grid.Row="0">
                                <Grid.Background>
                                    <ImageBrush ImageSource="{Binding Thumbnail}" TileMode="Tile" Stretch="UniformToFill" ViewportUnits="Absolute" Viewport="0,0,80,50" />
                                </Grid.Background>
                                <Rectangle Fill="#60000000" />
                                <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0" />
                            </Grid>

                            <!-- Bottom Part: Waveform -->
                            <Grid Grid.Row="1">
                                <controls:WaveformControl WaveformData="{Binding WaveformData}" />
                                <ProgressBar IsIndeterminate="True" Height="10" VerticalAlignment="Center" Margin="5"
                                             Visibility="{Binding IsGeneratingWaveform, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </Common:TimelineClipTemplateSelector.VideoClipTemplate>

            <!-- 2. AudioClip을 위한 템플릿 -->
            <Common:TimelineClipTemplateSelector.AudioClipTemplate>
                <DataTemplate>
                    <Border Width="{Binding Width}" Height="50" Background="#2A5D84" CornerRadius="3" ClipToBounds="True" Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="Black"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BorderBrush" Value="#FFD700"/>
                                        <Setter Property="BorderThickness" Value="2.5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                <b:InvokeCommandAction Command="{Binding DataContext.VideoEditor.ClipMouseDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" PassEventArgsToCommand="True" />
                            </b:EventTrigger>
                            <b:EventTrigger EventName="PreviewMouseMove">
                                <b:InvokeCommandAction Command="{Binding DataContext.VideoEditor.ClipMouseMoveCommand, RelativeSource={RelativeSource AncestorType=Window}}" PassEventArgsToCommand="True" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                        <Grid>
                            <controls:WaveformControl WaveformData="{Binding WaveformData}" />
                            <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0" />
                            <ProgressBar IsIndeterminate="True" Height="10" VerticalAlignment="Bottom" Margin="5"
                                         Visibility="{Binding IsGeneratingWaveform, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </Common:TimelineClipTemplateSelector.AudioClipTemplate>

            <!-- 3. ImageClip을 위한 템플릿 (요청하신 초록색 배경) -->
            <Common:TimelineClipTemplateSelector.ImageClipTemplate>
                <DataTemplate>
                    <Border Width="{Binding Width}" Height="50" Background="#3E8948" CornerRadius="3" ClipToBounds="True" Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="Black"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BorderBrush" Value="#FFD700"/>
                                        <Setter Property="BorderThickness" Value="2.5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                    <b:InvokeCommandAction Command="{Binding DataContext.VideoEditor.ClipMouseDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" PassEventArgsToCommand="True" />
                                </b:EventTrigger>
                                <b:EventTrigger EventName="PreviewMouseMove">
                                    <b:InvokeCommandAction Command="{Binding DataContext.VideoEditor.ClipMouseMoveCommand, RelativeSource={RelativeSource AncestorType=Window}}" PassEventArgsToCommand="True" />
                                </b:EventTrigger>
                            </b:Interaction.Triggers>

                            <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0" Cursor="Hand" />

                            <Rectangle Fill="Transparent" Width="8" HorizontalAlignment="Right" Cursor="SizeWE" Tag="ResizeHandle"
                                       PreviewMouseLeftButtonDown="ResizeHandle_PreviewMouseLeftButtonDown" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </Common:TimelineClipTemplateSelector.ImageClipTemplate>

            <!-- 4. TextClip을 위한 템플릿 (기본 회색 배경) -->
            <Common:TimelineClipTemplateSelector.TextClipTemplate>
                <DataTemplate>
                    <Border Width="{Binding Width}" Height="50" Background="#6E6E6E" CornerRadius="3" ClipToBounds="True" Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="Black"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BorderBrush" Value="#FFD700"/>
                                        <Setter Property="BorderThickness" Value="2.5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                    <b:InvokeCommandAction Command="{Binding DataContext.VideoEditor.ClipMouseDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" PassEventArgsToCommand="True" />
                                </b:EventTrigger>
                                <b:EventTrigger EventName="PreviewMouseMove">
                                    <b:InvokeCommandAction Command="{Binding DataContext.VideoEditor.ClipMouseMoveCommand, RelativeSource={RelativeSource AncestorType=Window}}" PassEventArgsToCommand="True" />
                                </b:EventTrigger>
                            </b:Interaction.Triggers>

                            <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0" Cursor="Hand" />

                            <Rectangle Fill="Transparent" Width="8" HorizontalAlignment="Right" Cursor="SizeWE" Tag="ResizeHandle"
                                       PreviewMouseLeftButtonDown="ResizeHandle_PreviewMouseLeftButtonDown" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </Common:TimelineClipTemplateSelector.TextClipTemplate>

        </Common:TimelineClipTemplateSelector>
        
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Common:TimeConverter x:Key="Converter" />
        <Common:TimeToPixelConverter x:Key="TimeToPixelConverter" />
        <Common:TrackToPositionConverter x:Key="TrackToPositionConverter" />
        <Common:TypeToBoolConverter x:Key="TypeToBoolConverter" />

        <DataTemplate DataType="{x:Type viewmodels:PlayerViewModel}">
            <views:SpeedEditorView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:TimelineClipBase}">
            <views:ClipEditorView/>
        </DataTemplate>


    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="5" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 타이틀바에 해당하는 공간 -->
        <Grid Grid.Row="0">
            <ui:TitleBar Grid.Row="0"
                         Title="Video Editor"
                         ShowMaximize="True"
                         ShowMinimize="True"
                         ShowClose="True" HorizontalAlignment="Stretch" Width="1500" />
        </Grid>

        <!-- 화면의 콘텐츠를 넣는 공간 -->
        <Grid Grid.Row="1">
            <!-- Grid Rows -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Toolbar/Menu -->
            <Menu Grid.Row="0" Background="#525252" Foreground="White">
                <!-- 파일 -->
                <MenuItem Header="파일" >
                    <MenuItem Header="새 프로젝트" Click="NewProject_Click"/>
                    <MenuItem Header="프로젝트 열기"/>
                    <MenuItem Header="프로젝트 초기화" Click="Project_Reset_Click"/>
                    <MenuItem Header="최근 파일 열기" />
                    <Separator/>
                    <MenuItem Header="미디어 가져오기" Click="btnSelectMedia_Click"/>
                    <Separator/>
                    <MenuItem Header="프로젝트 저장" />
                    <Separator/>
                    <MenuItem Header="렌더링" 
                              Command="{Binding DataContext.ExportVideoCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <MenuItem Header="렌더링 파일 미리보기" />
                    <Separator/>
                    <MenuItem Header="프로젝트 설정" />
                    <Separator/>
                    <MenuItem Header="환경 설정" />
                    <Separator/>
                    <MenuItem Header="종료" />
                </MenuItem>

                <!-- 편집 -->
                <MenuItem Header="편집">
                    <MenuItem Header="되돌리기(ctrl+z)" />
                    <MenuItem Header="다시 실행" />
                    <Separator/>
                    <MenuItem Header="자르기" />
                    <MenuItem Header="복사하기(ctrl+c)" />
                    <MenuItem Header="붙여넣기(ctrl+v)" />
                    <MenuItem Header="삭제(Del)" />
                    <MenuItem Header="모두 선택" />
                    <Separator/>
                </MenuItem>

                <!-- 도구 -->
                <MenuItem Header="도구">
                    <MenuItem Header="비디오">
                        <MenuItem Header="시계 방향 90도 회전" />
                        <MenuItem Header="시계 반대 방향 90도 회전" />
                    </MenuItem>
                    <MenuItem Header="오디오">
                        <MenuItem Header="오디오 분리" />
                        <MenuItem Header="뮤트" />
                        <MenuItem Header="음성 텍스트 변환" Command="{Binding TranscribeVideoCommand}" />
                    </MenuItem>
                    <MenuItem Header="배속" Command="{Binding EditorHost.ShowSpeedEditorCommand}"/>
                    <MenuItem Header="자막">
                        <MenuItem Header="자막 생성" 
                                  Command="{Binding VideoEditor.AddTextClipCommand}"
                                  CommandParameter="{Binding CurrentTimelinePosition}"/>
                        <MenuItem Header="음성 인식 자막 생성" />
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="클립 추출"/>
                    <MenuItem Header="자르기" x:Name="CutVideoButton"/>
                    <MenuItem Header="앞에 것만 남기고 삭제" />
                    <MenuItem Header="뒤에 것만 남기고 삭제" />

                </MenuItem>

                <!-- 보기 -->
                <MenuItem Header="보기">
                    <MenuItem Header="재생 / 일시 정지" />
                    <MenuItem Header="중지" />
                    <MenuItem Header="전체 화면 / 복원" />
                    <Separator/>
                    <MenuItem Header="배율" />
                    <MenuItem Header="이동">
                        <MenuItem Header="이전 프레임" />
                        <MenuItem Header="다음 프레임" />
                        <MenuItem Header="이전 클립" />
                        <MenuItem Header="다음 클립" />
                        <MenuItem Header="1초 이전" />
                        <MenuItem Header="1초 다음" />
                    </MenuItem>
                </MenuItem>
            </Menu>

            <!-- Main Content Area -->
            <Grid Grid.Row="1" Margin="5">
                <!-- 열 정의 -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <!-- 행 정의 (오른쪽 공간 안에서만 적용) -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="7*" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>

                <!-- 영상 리스트 -->
                <Border Grid.Column="0" Grid.RowSpan="2" Background="#36443d" BorderBrush="Black" BorderThickness="1">
                    <Expander Header="📹 미디어" IsExpanded="True" DataContext="{Binding}" VerticalAlignment="Top">
                        <ListBox ItemsSource="{Binding VideoList.MyVideoes}"
                                 DisplayMemberPath="Title"
                                 x:Name="mideaListBox"
                                 SelectedItem="{Binding VideoList.SelectedVideoItem}"
                                 AllowDrop="True"
                                 PreviewMouseLeftButtonDown="VideoList_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="VideoList_PreviewMouseMove"/>
                    </Expander>
                </Border>

                <!-- 영상 표시 -->
                <Border Grid.Column="1" Grid.Row="0" Background="#525252" BorderBrush="Black" BorderThickness="1">
                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <!-- 영상이 들어갈 공간 -->
                            <RowDefinition Height="Auto"/>
                            <!-- 영상 조작 UI (StackPanel) -->
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">

                            <Border Margin="5" Background="{Binding PlayerViewModel.VideoViewBackground}" />

                            <!-- 1. 비디오 플레이어 뷰  -->
                            <Grid Margin="5" x:Name="VideoPlayerHost" SizeChanged="VideoPlayerHost_SizeChanged">
                                <vlc:VideoView x:Name="videoView0" />
                                <vlc:VideoView x:Name="videoView1" />
                                <vlc:VideoView x:Name="videoView2" />
                                <vlc:VideoView x:Name="videoView3" />
                                <vlc:VideoView x:Name="videoView4" />
                            </Grid>

                            <Border x:Name="PreviewHighlightBorder" 
                                    Margin="{Binding HighlightBorderMargin}"
                                    BorderBrush="#FFD700" 
                                    BorderThickness="4" 
                                    CornerRadius="3"
                                    SnapsToDevicePixels="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <!-- 기본 상태는 보이지 않음 -->
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect ShadowDepth="0" Color="#FFD700" Opacity="0.9" BlurRadius="15" />
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <!-- HighlightedVisualClip이 VideoClip일 때 보이도록 설정 -->
                                            <DataTrigger Binding="{Binding HighlightedVisualClip, Converter={StaticResource TypeToBoolConverter}, ConverterParameter={x:Type models:VideoClip}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <!-- HighlightedVisualClip이 ImageClip일 때 보이도록 설정 -->
                                            <DataTrigger Binding="{Binding HighlightedVisualClip, Converter={StaticResource TypeToBoolConverter}, ConverterParameter={x:Type models:ImageClip}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- ✨ [결정적인 수정] 자막을 Popup 컨트롤 안에 배치 -->
                            <Popup x:Name="SubtitlePopup"
                                   IsOpen="{Binding IsTextVisible, Mode=OneWay}"
                                   PlacementTarget="{Binding ElementName=VideoPlayerHost}"
                                   Placement="Relative"
                                   AllowsTransparency="True">

                                <!-- Popup 내부의 Grid가 비디오 영역과 동일한 크기를 갖도록 설정 -->
                                <Grid Width="{Binding ElementName=VideoPlayerHost, Path=ActualWidth}"
                                      Height="{Binding ElementName=VideoPlayerHost, Path=ActualHeight}">

                                    <Border Margin="10" Padding="10,5" CornerRadius="5"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Background="#80000000">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <!-- 기본 상태: 투명한 테두리, 효과 없음 -->
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                                <Setter Property="Effect" Value="{x:Null}"/>
                                                <Style.Triggers>
                                                    <!-- 
                        MainWindow의 DataContext(MainViewModel)에 있는 HighlightedVisualClip이 TextClip일 때
                        이 트리거가 활성화됩니다.
                        -->
                                                    <DataTrigger Binding="{Binding DataContext.HighlightedVisualClip, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TypeToBoolConverter}, ConverterParameter={x:Type models:TextClip}}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#FFD700"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect ShadowDepth="0" Color="#FFD700" Opacity="0.9" BlurRadius="10" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <TextBlock Text="{Binding ActiveDisplayText}"
                                                   Foreground="White"
                                                   FontSize="24"
                                                   FontWeight="Bold"
                                                   TextAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Popup>

                        </Grid>

                        <!-- 기존 컨트롤 바 (변경 없음) -->
                        <StackPanel x:Name="show_VideoBar" 
                                    Orientation="Horizontal" 
                                    Grid.Row="1" 
                                    Margin="10,0,10,10" 
                                    Visibility="{Binding PlayerViewModel.IsControlBarVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    VerticalAlignment="Bottom" 
                                    Grid.ColumnSpan="2">

                                    <Button Content="{Binding PlayPauseButtonContent}"
                                            Command="{Binding PlayPauseTimelineCommand}"
                                            Width="40"/>

                                    <Button x:Name="btnStop" Content="■" Width="40" Margin="5,0,0,0"
                                            Command="{Binding StopTimelineCommand}"/>

                                    <TextBlock Text="{Binding CurrentTimelineTimeMs, Converter={StaticResource Converter}}"
                                               VerticalAlignment="Center" Margin="5,0"/>

                                    <Slider Width="300" Minimum="0"
                                            Value="{Binding CurrentTimelineTimeMs, Mode=TwoWay}"
                                            Maximum="{Binding PlayerViewModel.TotalDuration}"
                                            IsSnapToTickEnabled="True" TickFrequency="1000" />
                                    <TextBlock Text="{Binding TotalTimelineDurationMs, Converter={StaticResource Converter}}"
                                               Margin="10,0,10,0" VerticalAlignment="Center"/>

                                    <TextBlock Text="볼륨" VerticalAlignment="Center" Margin="10,0,5,0"/>
                            <Slider Width="100" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                    Value="{Binding PlayerViewModel.Volume, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right Panel: Properties and Subtitles -->
                <Border Grid.Column="2" Grid.Row="0" Background="#36443d" BorderBrush="Black" BorderThickness="1">
                    <ContentControl Content="{Binding EditorHost.CurrentEditor}"/>
                </Border>

                <Border Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2"
                        Background="#525252"  
                        BorderBrush="Black"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- 상단 메뉴 -->
                            <RowDefinition Height="30"/>
                            <!-- 눈금자 -->
                            <RowDefinition Height="*"/>
                            <!-- 타임라인 -->
                        </Grid.RowDefinitions>

                        <!-- ✅ (1) 타임라인 상단 메뉴 -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5,2,5,2">
                            <Button x:Name="btnZoomIn" Content="확대(+)" Margin="2" Command="{Binding VideoEditor.ZoomInCommand}"/>
                            <Button x:Name="btnZoomOut" Content="축소(-)" Margin="2" Command="{Binding VideoEditor.ZoomOutCommand}"/>
                            <TextBlock Text="확대/축소: " Foreground="White" VerticalAlignment="Center" Margin="10,0,5,0"/>
                            <TextBlock x:Name="txtZoomValue" Text="{Binding VideoEditor.ZoomPercentage, StringFormat={}{0:F0}%}" Foreground="White" VerticalAlignment="Center" Width="50"/>
                            <Button x:Name="btnSplitClip" Content="클립 분할" Margin="10,2,2,2" Command="{Binding VideoEditor.SplitClipCommand}" CommandParameter="{Binding CurrentTimelinePosition}"/>
                            <Button x:Name="btnCopyClip" Content="복사" Margin="2" Command="{Binding VideoEditor.CopySelectedClipCommand}"/>
                            <Button x:Name="btnPasteClip" Content="붙여넣기" Margin="2" Command="{Binding VideoEditor.PasteClipCommand}" CommandParameter="{Binding CurrentTimelinePosition}"/>
                            <Button x:Name="btnDeleteClip" Content="삭제" Margin="2" Command="{Binding VideoEditor.DeleteSelectedClipCommand}"/>
                            <Button x:Name="btnExportVideo" Content="내보내기" Margin="15,2,2,2" Background="#5F9E30" Foreground="White" 
                                    Command="{Binding DataContext.ExportVideoCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </StackPanel>

                        <!-- ✅ (2) 시간 눈금자 -->
                        <ScrollViewer x:Name="RulerScrollViewer"
                                      Grid.Row="1"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      Height="60"
                                      Background="Transparent"
                                      IsHitTestVisible="False">
                            <Canvas x:Name="TimelineRulerCanvas"
                                    Height="60"
                                    Panel.ZIndex="5"
                                    Background="Transparent"/>
                        </ScrollViewer>

                        <ScrollViewer x:Name="TimelineScrollViewer"
                                      Grid.Row="2"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      AllowDrop="True"
                                      Background="Transparent">

                            <!-- 모든 타임라인 요소를 담을 Grid -->
                            <Grid x:Name="TimelineCanvas" Height="300" 
                                  Background="Transparent"
                                  AllowDrop="True"
                                  DragOver="Timeline_DragOver">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="Drop">
                                        <b:InvokeCommandAction Command="{Binding VideoEditor.DropOnTimelineCommand}"
                                   PassEventArgsToCommand="True" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>

                                <Canvas x:Name="PlayheadCanvas"
                                        Height="300"
                                        IsHitTestVisible="False"
                                        Panel.ZIndex="20"/>

                                <ItemsControl x:Name="ClipsItemsControl" 
                                              ItemsSource="{Binding VideoEditor.TimelineClips}"
                                              ItemTemplateSelector="{StaticResource ClipTemplateSelector}"
                                              Panel.ZIndex="10" 
                                              Margin="0,10,0,-10">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding StartPosition, Converter={StaticResource TimeToPixelConverter}}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding TrackIndex, Converter={StaticResource TrackToPositionConverter}}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>

                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>


    </Grid>
</Window>
