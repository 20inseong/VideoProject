<UserControl x:Class="VideoEditor.Views.EmotionAnalysisProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#80000000">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
            <TextBlock Text="감정 분석 실행 중..." Foreground="White" FontSize="20" HorizontalAlignment="Center"/>
            <ProgressBar Value="{Binding AnalysisProgress}" Width="300" Height="20" Margin="0,10,0,0"/>
            <TextBlock Text="{Binding AnalysisProgress, StringFormat={}{0}%}" Foreground="White" FontSize="16" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
